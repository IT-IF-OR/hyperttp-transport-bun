{
  "name": "@hyperttp/transport-bun",
  "version": "0.3.2",
  "description": "High-performance HTTP transport for Bun with native fetch optimizations",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "http",
    "transport",
    "high-performance",
    "fetch",
    "bun",
    "hyperttp"
  ],
  "author": "dirold2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-transport-bun.git"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.3.0",
    "hcacher": "^0.3.0"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^7.0.2",
    "vitest": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "tsc && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "pub": "d-publish",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  }
}
